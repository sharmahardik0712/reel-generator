{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Same name as before, so it takes over https://reel.<you>.workers.dev
	"name": "reel",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	// Cloudflare creates the DNS records and HTTPS certificates for these.
	// www redirects to the bare domain in src/index.ts.
	"routes": [
		{ "pattern": "makemyreel.in", "custom_domain": true },
		{ "pattern": "www.makemyreel.in", "custom_domain": true }
	],
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "ReelContainer",
			// One container holds all state (uploads, queue, reels). The Worker always
			// routes to the instance named "main", so there is never more than one.
			"scheduling_policy": "durable_object",
			"images": {
				// Built from the repo root so the image can include engine/.
				"base": { "dockerfile": "../Dockerfile" }
			}
		}
	],
	"durable_objects": {
		"bindings": [{ "class_name": "ReelContainer", "name": "REEL" }]
	},
	"exports": {
		"ReelContainer": { "type": "durable-object", "storage": "sqlite" }
	}
}
